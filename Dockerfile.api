# CPU-only image for the UVR headless API.
#
# Based on Debian bookworm's distro Python 3.11 (NOT the official python:* image)
# specifically because UVR.py and the vendored demucs modules `import tkinter` at
# module load. The official python images don't bundle the _tkinter C extension
# and `apt install tk` can't add it after the fact; the distro's `python3-tk`
# package does provide a working tkinter for the distro interpreter. tkinter is
# never actually rendered — the imports just need to resolve headlessly.
FROM debian:bookworm-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UVR_DATA_DIR=/data \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    # Allow the legacy `sklearn` shim (a transitive dep) to install.
    SKLEARN_ALLOW_DEPRECATED_SKLEARN_PACKAGE_INSTALL=True

# System deps:
#   python3 + venv + pip   the interpreter (3.11 on bookworm)
#   python3-tk             working tkinter for headless imports
#   python3-dev/build*     compile diffq's C extension
#   ffmpeg / libsndfile1   audio decode/encode (mp3/flac/wav)
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-dev python3-tk \
        build-essential \
        ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# Isolated venv (bookworm's system Python is PEP 668 externally-managed).
# Do NOT upgrade pip: the venv's bundled pip/setuptools build the sdist-only
# deps (ml_collections, Dora, pyrubberband) cleanly, whereas a newer setuptools
# breaks playsound's setup.py. Just add wheel (needed for diffq's C-ext build).
RUN python3 -m venv $VIRTUAL_ENV && pip install wheel

WORKDIR /app

# Install a matched CPU torch/torchvision pair FIRST — a mismatched torchvision
# pulled transitively otherwise breaks `import torchvision.ops`. Then the rest.
COPY requirements.txt requirements-api.txt ./
# Pin playsound to its 1.2.2 wheel (no sdist build) before requirements pulls the
# unbuildable 1.3.0; the bare `playsound` in requirements.txt is then satisfied.
RUN pip install --index-url https://download.pytorch.org/whl/cpu torch==2.2.2 torchvision==0.17.2 \
    && pip install playsound==1.2.2 \
    && pip install -r requirements.txt \
    && pip install -r requirements-api.txt

# App source. Model weights and job data live on mounted volumes.
COPY . .

EXPOSE 8000
VOLUME ["/data", "/app/models"]

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
